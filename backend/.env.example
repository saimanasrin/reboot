# Copy to backend/.env. Secrets live here (server side) - never in the frontend.

# Optional: enables LLM narration in "Ask Q-Chain". Without it, a deterministic template explainer is used.
ANTHROPIC_API_KEY=
QCHAIN_AGENT_MODEL=claude-opus-5

# Change these for anything beyond a local demo.
QCHAIN_AUTH_SECRET=dev-only-change-me
QCHAIN_DEVICE_API_KEY=demo-device-key
QCHAIN_ADMIN_PASSWORD=admin123
QCHAIN_WAREHOUSE_PASSWORD=warehouse123
QCHAIN_DISTRIBUTOR_PASSWORD=distributor123
QCHAIN_RETAILER_PASSWORD=retailer123

# SQLite by default. PostgreSQL example:
# QCHAIN_DATABASE_URL=postgresql+psycopg://qchain:qchain@localhost:5432/qchain

# Fixed simulation clock (Asia/Qatar local time) so every demo figure is reproducible.
QCHAIN_DEMO_NOW=2026-09-25T14:00:00
QCHAIN_FLEET_SIZE=1284
